#!/bin/sh

# Script to run commands in docker. Execute it without parameters to build image.

SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"

if [ $# -eq 0 ]; then
    exec docker buildx build -t otbi "$SCRIPT_DIR/.."
    exit $?
fi

tty_flags=""
if [ -t 0 ] && [ -t 1 ]; then
    tty_flags="-it"
fi

uid="$(id -u)"
gid="$(id -g)"

exec docker run $tty_flags --rm \
    --network=host \
    --user "$uid:$gid" \
    -v $PWD:/otclient \
    otbi "$@"
